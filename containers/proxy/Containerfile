# hobgoblin proxy: mitmproxy + the hobgoblin addon on UBI 9.
# Build from the repository root:
#   podman build -t localhost/hobgoblin-proxy:latest -f containers/proxy/Containerfile .

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

RUN microdnf -y install python3.12 python3.12-pip ca-certificates \
 && microdnf clean all

COPY pyproject.toml README.md /src/
COPY src /src/src
RUN python3.12 -m venv /opt/hobgoblin \
 && /opt/hobgoblin/bin/pip install --no-cache-dir "/src[proxy]" \
 && rm -rf /src

# The launcher uses --read-only, --userns=keep-id and an explicit --user to
# match the bind-mount owner. /tmp and /run are tmpfs; the CA key stays in /tmp.
ENV PATH=/opt/hobgoblin/bin:$PATH \
    HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
USER 65534
EXPOSE 3128
ENTRYPOINT ["hobgoblin-proxy"]
